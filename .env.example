# ---- Django ----
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=inventory.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://inventory.example.com
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# ---- Database ----
# sqlite    - single file, fine for a pilot or a one-PC LAN install
# postgres  - recommended for a VPS / Docker deployment
# mysql     - what shared cPanel hosting offers; uses PyMySQL, no compiler needed
DB_ENGINE=postgres
DB_NAME=spares
DB_USER=spares
DB_PASSWORD=change-this
DB_HOST=db
DB_PORT=5432
# On cPanel, remember the account prefix: DB_NAME=tulsi_spares, DB_USER=tulsi_spuser,
# DB_HOST=localhost, DB_PORT=3306. See docs/CPANEL_HOSTING.md.

# ---- Storage ----
MEDIA_ROOT=/data/media
BACKUP_ROOT=/data/backups
MAX_UPLOAD_SIZE_MB=25
# Django serves uploaded images and documents itself by default, which is what an
# on-premise install needs. Set this to 0 when nginx has a /media/ alias.
SERVE_MEDIA=0

# ---- Public QR links ----
# The base URL printed into every label QR code. It must be reachable from a phone,
# and it must be STABLE - it is physically on every sticker you print.
# Leave it blank and the app uses this machine's detected LAN address, which is
# convenient for a local install but changes if DHCP reassigns the PC.
# For a LAN install:   PUBLIC_BASE_URL=http://192.168.1.45:8000
# For a cloud install: PUBLIC_BASE_URL=https://inventory.example.com
PUBLIC_BASE_URL=https://inventory.example.com
PUBLIC_HOST_PORT=8000

# ---- Labels ----
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=25

# ---- API ----
API_RATE_LIMIT=1000/hour
SCAN_RATE_LIMIT=600/minute

# ---- HTTPS ----
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
